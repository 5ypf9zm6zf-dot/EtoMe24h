# Server-only secret — NEVER use NEXT_PUBLIC_ here
OPENAI_API_KEY=

# Provider selection (defaults to OpenAI; Gemini is opt-in)
AI_PROVIDER=openai

# Optional model override
OPENAI_MODEL=gpt-5-mini

# Preview Redis: choose ONE complete pair. Do not commit real values.
# Direct Upstash (takes precedence if either direct variable is present):
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=
# Or Marketplace (do not use a read-only token):
# KV_REST_API_URL=https://your-database.upstash.io
# KV_REST_API_TOKEN=
# Never share Production counters/credentials for readiness testing.
