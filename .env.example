# Server-only secret — NEVER use NEXT_PUBLIC_ here
OPENAI_API_KEY=

# Optional model override
OPENAI_MODEL=gpt-5-mini

# Required shared rate limiter for the public AI endpoint (Upstash Redis REST)
# Keep both values server-only; never use NEXT_PUBLIC_ prefixes.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional canonical production URL; default is https://www.etome24.hr
NEXT_PUBLIC_SITE_URL=https://www.etome24.hr
